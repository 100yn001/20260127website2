{
  "buildCommand": "bash scripts/build-all.sh",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/thesynk", "destination": "/index.html" },
    { "source": "/thesynk/support", "destination": "/index.html" },
    { "source": "/thesynk/privacy", "destination": "/index.html" },
    { "source": "/sink/:id", "destination": "/sink/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/app/_expo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
