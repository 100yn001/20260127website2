// Live Storage rules (versioned here to match what's deployed).
// NOTE: the previous repo version also had a `static-audio/{filename}` read
// rule (allow read: if request.auth != null). Your deployed rules do not.
// If static / pre-generated stories play their audio from a `static-audio/`
// Storage path and now fail to load, re-add that block.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Generated audio: any signed-in user may READ (playback URLs are shared);
    // WRITE only your own files (filenames are `{uid}-{timestamp}-chunkN.mp3`).
    match /generated-audio/{folder}/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && file.matches(request.auth.uid + '-.*');
    }

    // Shared artwork: world-readable; only the owner may upload to their folder.
    match /sharedArtwork/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin-managed static areas:
    //   masters/       marketing masters (yt audio/video + transcripts) — the
    //                  Airtable click-to-play archive (push-artifacts.mjs)
    //   static-assets/ app-wide files (ambience bed loops — beds.mjs)
    // Consumers use tokened download URLs (which bypass rules), so reads stay
    // tight: masters admin-only, static-assets any signed-in user.
    match /masters/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'ellepotterhead2006@gmail.com';
    }
    match /static-assets/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'ellepotterhead2006@gmail.com';
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
